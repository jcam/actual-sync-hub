NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:4000
APP_INSTANCE_LABEL=Actual Sync Hub
SESSION_SECRET=replace-with-long-random-secret-at-least-32
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
DATABASE_URL=file:../data/sync.db

# Required Actual runtime wiring
ACTUAL_SERVER_URL=http://localhost:5006
ACTUAL_SERVER_PASSWORD=replace-me
ACTUAL_BUDGET_SYNC_ID=replace-me
ACTUAL_BUDGET_ENCRYPTION_PASSWORD=
ACTUAL_DATA_DIR=./data/actual-cache
ACTUAL_API_VERSION_MATCH_MODE=auto
ACTUAL_SYNC_EVENT_DEBUG=0

# Optional live-test / live-sandbox helpers
ACTUAL_TEST_RUN_LIVE=1
ACTUAL_TEST_IMAGE=ghcr.io/actualbudget/actual:26.5.0-alpine
ACTUAL_TEST_PASSWORD=actual-test-password
ACTUAL_TEST_PORT=5007

# Local dev helpers
PROVIDER_FIXTURE_CACHE_ENABLED=0
PROVIDER_FIXTURE_CACHE_FILE=./.local/provider-fixtures.json

# Optional live sandbox / live test provider injection
PLAID_TEST_RUN_LIVE=1
PLAID_TEST_CLIENT_ID=
PLAID_TEST_SECRET=
PLAID_TEST_ENV=sandbox
STRIPE_TEST_RUN_LIVE=0
STRIPE_TEST_ENV=test
STRIPE_TEST_PUBLISHABLE_KEY=
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SIGNING_SECRETS=
STRIPE_TEST_CUSTOMER_ID=
STRIPE_TEST_ACCOUNT_ID=
SIMPLEFIN_TEST_RUN_LIVE=0
SIMPLEFIN_TEST_ACCESS_KEY=
SIMPLEFIN_TEST_ACCOUNT_ID=
SALT_EDGE_TEST_RUN_LIVE=0
SALT_EDGE_TEST_ENVIRONMENT=sandbox
SALT_EDGE_TEST_APP_ID=
SALT_EDGE_TEST_SECRET=
SALT_EDGE_TEST_CONNECTION_ID=
SALT_EDGE_TEST_CONNECTION_SECRET=
SALT_EDGE_TEST_CUSTOMER_ID=
SALT_EDGE_TEST_ACCOUNT_ID=
TELLER_TEST_RUN_LIVE=0
TELLER_TEST_APP_ID=
TELLER_TEST_ENV=sandbox
TELLER_TEST_CERT_FILE=
TELLER_TEST_KEY_FILE=
TELLER_TEST_SANDBOX_ACCESS_TOKEN=
TELLER_TEST_WEBHOOK_SIGNING_SECRETS=
TELLER_TEST_ACCOUNT_ID=
FULL_SYNC_TEST_RUN_LIVE=0
