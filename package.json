{
  "name": "actual-sync-hub",
  "version": "0.23.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "@hono/node-server": "1.19.13"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm run dev -w apps/server\" \"npm run dev -w apps/web\"",
    "dev:live-sandbox": "tsx scripts/dev-live-sandbox.ts start",
    "dev:live-sandbox:stop": "tsx scripts/dev-live-sandbox.ts stop",
    "dev:live-sandbox:remove-node-modules-volume": "tsx scripts/dev-live-sandbox.ts remove-node-modules-volume",
    "dev:env:init": "node scripts/init-provider-env.mjs",
    "dev:env:init:plaid": "node scripts/init-provider-env.mjs --provider PLAID",
    "dev:env:init:stripe": "node scripts/init-provider-env.mjs --provider STRIPE",
    "dev:env:init:teller": "node scripts/init-provider-env.mjs --provider TELLER",
    "dev:env:init:simplefin": "node scripts/init-provider-env.mjs --provider SIMPLEFIN",
    "dev:env:init:saltedge": "node scripts/init-provider-env.mjs --provider SALT_EDGE",
    "dev:env:init:home-values": "node scripts/init-provider-env.mjs --provider HOME_VALUES",
    "build": "npm run build -w packages/shared && npm run build -w apps/web && npm run build -w apps/server",
    "format:check": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "lint:code": "oxlint --type-aware --quiet",
    "lint:fix": "oxlint --fix --type-aware --quiet",
    "lint:types": "npm run build -w packages/shared && npm run lint -w apps/server && npm run lint -w apps/web",
    "lint": "npm run lint:code && npm run lint:types",
    "test": "npm run test:unit && npm run test:ui",
    "test:actual-live": "vitest run apps/server/src/services/actual-service.live.test.ts",
    "test:unit": "ACTUAL_TEST_RUN_LIVE=0 PLAID_TEST_RUN_LIVE=0 STRIPE_TEST_RUN_LIVE=0 TELLER_TEST_RUN_LIVE=0 SIMPLEFIN_TEST_RUN_LIVE=0 SALT_EDGE_TEST_RUN_LIVE=0 FULL_SYNC_TEST_RUN_LIVE=0 vitest run",
    "test:ui": "playwright test",
    "test:ui:headed": "playwright test --headed",
    "test:ui:server": "tsx scripts/start-playwright-ui-server.ts",
    "test:full-live": "FULL_SYNC_TEST_RUN_LIVE=1 LIVE_SANDBOX_MODE=1 vitest run apps/server/src/integration/full-sync.live.test.ts",
    "test:plaid-live": "vitest run apps/server/src/services/plaid-service.live.test.ts",
    "test:stripe-live": "vitest run apps/server/src/services/stripe-service.live.test.ts",
    "test:stripe-full-live": "ACTUAL_TEST_RUN_LIVE=1 STRIPE_TEST_RUN_LIVE=1 vitest run apps/server/src/integration/stripe-full.live.test.ts",
    "test:teller-live": "vitest run apps/server/src/services/teller-service.live.test.ts",
    "test:simplefin-live": "vitest run apps/server/src/services/simplefin-service.live.test.ts",
    "test:saltedge-live": "SALT_EDGE_TEST_RUN_LIVE=1 vitest run apps/server/src/services/saltedge-service.live.test.ts",
    "test:saltedge-full-live": "ACTUAL_TEST_RUN_LIVE=1 SALT_EDGE_TEST_RUN_LIVE=1 vitest run apps/server/src/integration/saltedge-full.live.test.ts",
    "test:watch": "vitest",
    "test:coverage": "npm run test:unit -- --coverage",
    "db:generate": "XDG_CACHE_HOME=.cache prisma generate",
    "db:push": "XDG_CACHE_HOME=.cache prisma db push && XDG_CACHE_HOME=.cache prisma generate",
    "postinstall": "XDG_CACHE_HOME=.cache prisma generate && npm run build -w packages/shared"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.60.0",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "concurrently": "^9.2.1",
    "dotenv": "^17.4.2",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.59.0",
    "oxlint-tsgolint": "^0.22.1",
    "prisma": "^7.8.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
